{
    # Thins out error floods that would block Caddy and rotate away the logs
    log default {
        # Per second by default, Caddy 2.9 can't parse an explicit interval
        sampling {
            first 10
            thereafter 1000
        }
    }
}

(data-processor) {
    reverse_proxy http://bstats-data-processor:8080 {
        # Retries failed connects instead of answering 502, safe for POST
        lb_try_duration 5s
        # Lets retries resend the body, which is usually under 1 KB
        request_buffers 64k
        # Below the data processor's keep-alive (120s), so Caddy closes idle connections first
        transport http {
            keepalive 90s
            keepalive_idle_conns_per_host 256
            # Caps the connection flood in stalls, normally ~100 are open
            max_conns_per_host 4096
        }
    }
}

http://bstats.org bstats.org http://bstats.localhost bstats.localhost {
    encode gzip

    handle_path /submitData/* {
        rewrite * /legacy{path}
        import data-processor
    }

    handle /submitData {
        rewrite * /legacy/bukkit
        import data-processor
    }

    handle_path /api/v2/data/* {
        rewrite * {path}
        import data-processor
    }

    handle_path /api/v2/* {
        reverse_proxy http://nginx-backend:3001
    }

    handle_path /api-list* {
        rewrite * /api-list{path}
        reverse_proxy http://nginx-backend:3001
    }

    handle_path /signatures/* {
        rewrite * /signatures{path}
        reverse_proxy http://nginx-backend:3001
    }

    handle_path /api/v1/plugins {
        rewrite * /services{path}
        reverse_proxy http://nginx-backend:3001
    }

    handle_path /api/v1/plugins/* {
        rewrite * /legacy/service{path}
        reverse_proxy http://nginx-backend:3001
    }

    # Catch-all proxy for all other requests
    reverse_proxy http://bstats-web:3000
}
